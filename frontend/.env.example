# Copy to .env.local to use the Node.js backend (Coffee Palace\backend).
# Leave it unset to use the built-in stand-in API (app/api/*).
# On the shop network use the server's IP, not localhost: the tablet calls this address directly.
# NEXT_PUBLIC_API_URL is baked in at build time: rebuild (or restart npm run dev) after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

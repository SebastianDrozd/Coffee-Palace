# Copy this file to .env and adjust.

PORT=4000

# XAMPP defaults: user root, no password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coffee_palace

# Only needed when the website runs from another address, e.g. `npm run dev` in the frontend folder.
# Not needed when this server serves the website itself (the public/ folder), which is the normal setup.
# Several addresses: separate with commas, e.g. http://localhost:3000,http://192.168.1.50:3000
CORS_ORIGIN=http://localhost:3000

# Product photos are saved here
UPLOADS_DIR=./uploads

# Business day for order numbers and "today's" BCV rate
BUSINESS_TIMEZONE=America/Caracas

# BCV dollar rate (https://www.bcv.org.ve/)
BCV_ENABLED=true
BCV_CHECK_MINUTES=60
BCV_RETRY_MINUTES=10
